	partition fct_wanek_onhand = m
		mode: import
		source =
				let
				    Source = Sql.Database("WanekWHJSQLprod", "AAD", [Query="SELECT #(lf)    sto.sequence,#(lf)    sto.item_number,#(lf)    sto.actual_qty,#(lf)    sto.unavailable_qty,#(lf)    sto.status,#(lf)    sto.wh_id,#(lf)    sto.location_id,#(lf)    loc.type,#(lf)    sto.fifo_date,#(lf)    sto.expiration_date,#(lf)    sto.reserved_for,#(lf)    sto.lot_number,#(lf)    sto.inspection_code,#(lf)    sto.serial_number,#(lf)    sto.type,#(lf)    sto.put_away_location,#(lf)    sto.owner_id,#(lf)    sto.pod_status#(lf)FROM t_stored_item sto WITH (NOLOCK)#(lf)JOIN t_location loc WITH (NOLOCK)#(lf)    ON sto.location_id = loc.location_id#(lf)    AND sto.wh_id = loc.wh_id#(lf)    AND loc.type <> 'MA'#(lf)JOIN t_item_master itm WITH (NOLOCK)#(lf)    ON sto.item_number = itm.item_number#(lf)    AND sto.wh_id = itm.wh_id#(lf)WHERE sto.wh_id in ('31','33','34','35','36')#(lf)    AND sto.location_id LIKE '%'#(lf)    AND sto.item_number LIKE '%'#(lf)    AND sto.status LIKE '%'#(lf)    AND (#(lf)            ('%' = 'NULL' AND sto.lot_number IS NULL)#(lf)         OR ('%' = 'NOT NULL' AND sto.lot_number IS NOT NULL)#(lf)         OR ('%' = '%')#(lf)        )#(lf)    AND sto.type LIKE '%'#(lf)    AND ISNULL(loc.building, '') LIKE '%'#(lf)    AND itm.pick_put_id LIKE '%'#(lf)    AND itm.commodity_code Like 'Z%' and itm.commodity_code NOT Like '%K'#(lf)    AND sto.type = 'STORAGE'#(lf)ORDER BY #(lf)    sto.item_number,#(lf)    sto.location_id;", CreateNavigationProperties=false, CommandTimeout=#duration(0, 8, 20, 0)])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

