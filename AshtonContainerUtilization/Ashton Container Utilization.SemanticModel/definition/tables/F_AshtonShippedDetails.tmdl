	column Utilization =
			SWITCH(TRUE(),
			MID('F_AshtonShippedDetails'[ContainerSize],1,2) = "53", 'F_AshtonShippedDetails'[Cubes]/3831,
			MID('F_AshtonShippedDetails'[ContainerSize],1,2) = "50", 'F_AshtonShippedDetails'[Cubes]/3333,
			MID('F_AshtonShippedDetails'[ContainerSize],1,3) = "40H", 'F_AshtonShippedDetails'[Cubes]/2650,
			MID('F_AshtonShippedDetails'[ContainerSize],1,3) = "40", 'F_AshtonShippedDetails'[Cubes]/2383,
			MID('F_AshtonShippedDetails'[ContainerSize],1,1) = "2", 'F_AshtonShippedDetails'[Cubes]/1191,
			MID('F_AshtonShippedDetails'[ContainerSize],1,1) = "" && 'F_AshtonShippedDetails'[ContainerAccumulatedCubes]<=1191, 'F_AshtonShippedDetails'[Cubes]/1191,
			'F_AshtonShippedDetails'[Cubes]/2650)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e307f939-26e7-4a9c-88b8-50ad8d2e9eb8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ContainerAccumulatedUlitization = CALCULATE(SUM(F_AshtonShippedDetails[Utilization]),ALLEXCEPT('F_AshtonShippedDetails','F_AshtonShippedDetails'[TRIP#],'F_AshtonShippedDetails'[Container#]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 15a99665-cc29-4fee-a288-ddbcc6bda6a7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column UtilizationRange =
			SWITCH(true(),
			'F_AshtonShippedDetails'[ContainerAccumulatedUlitization]<0.7,"a. 0~70%",
			'F_AshtonShippedDetails'[ContainerAccumulatedUlitization]<0.8,"b. 70%~80%",
			'F_AshtonShippedDetails'[ContainerAccumulatedUlitization]<0.85,"c. 80%~85%",
			'F_AshtonShippedDetails'[ContainerAccumulatedUlitization]<0.9,"d. 85%~90%",
			'F_AshtonShippedDetails'[ContainerAccumulatedUlitization]<0.95,"e. 90%~95%",
			'F_AshtonShippedDetails'[ContainerAccumulatedUlitization]<1,"f. 95%~100%",
			"j. Over 100%"
			)
		lineageTag: 7e2e02c0-726a-4355-9208-ec5090aebdbf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ContainerAccumulatedCubes = CALCULATE(SUM(F_AshtonShippedDetails[Cubes]),ALLEXCEPT('F_AshtonShippedDetails','F_AshtonShippedDetails'[TRIP#],'F_AshtonShippedDetails'[Container#]))
		lineageTag: c1b5c1f1-0618-43ea-a621-832aa971c2ae
