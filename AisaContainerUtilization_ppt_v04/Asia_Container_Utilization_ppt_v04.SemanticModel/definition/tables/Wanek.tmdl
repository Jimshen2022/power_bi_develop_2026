	column Cont_Categories = IF('Wanek'[ContainerType]="Mixed","Mixed",if(and('Wanek'[Product]="UPH",SUMX(FILTER('Wanek','Wanek'[Container#]=EARLIER('Wanek'[Container#])),'Wanek'[Judge])=0),"Motion",if(and('Wanek'[Product]="UPH",SUMX(FILTER('Wanek','Wanek'[Container#]=EARLIER('Wanek'[Container#])),'Wanek'[Judge])=COUNTX(FILTER('Wanek','Wanek'[Container#]=EARLIER('Wanek'[Container#])),'Wanek'[Judge])),"Stationary",if(and('Wanek'[Product]="UPH",SUMX(FILTER('Wanek','Wanek'[Container#]=EARLIER('Wanek'[Container#])),'Wanek'[Judge])<COUNTX(FILTER('Wanek','Wanek'[Container#]=EARLIER('Wanek'[Container#])),'Wanek'[Judge])),"Mixed",'Wanek'[Product]))))
