		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Judge = if(and('Wanek'[PRODUCT]="UPH",'Wanek'[MS]="Motion"),0,if(and('Wanek'[Product]="UPH",'Wanek'[MS]="Stationary"),1,9999))
