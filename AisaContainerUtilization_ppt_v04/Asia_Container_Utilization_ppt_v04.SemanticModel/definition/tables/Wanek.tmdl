	column MS = IF(AND('Wanek'[PRODUCT]="UPH",LOOKUPVALUE('M&S'[Kind],'M&S'[Item],'Wanek'[ITEMNUMBER])="Motion"),"Motion", IF(AND('Wanek'[PRODUCT]="UPH",LOOKUPVALUE('M&S'[Kind],'M&S'[Item],'Wanek'[ITEMNUMBER])<>"Motion"),"Stationary",""))
