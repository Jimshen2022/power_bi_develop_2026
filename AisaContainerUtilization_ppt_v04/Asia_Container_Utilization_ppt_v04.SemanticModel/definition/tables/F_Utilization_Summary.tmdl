	column Utilization =
			SWITCH(TRUE(),
			MID('F_Utilization_Summary'[WCHCONTAINERSIZE],1,2) = "53", 'F_Utilization_Summary'[Cubes]/3831,
			MID('F_Utilization_Summary'[WCHCONTAINERSIZE],1,2) = "50", 'F_Utilization_Summary'[CUBES]/3333,
			MID('F_Utilization_Summary'[WCHCONTAINERSIZE],1,2) = "45", 'F_Utilization_Summary'[CUBES]/3037,
