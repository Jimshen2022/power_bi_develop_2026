	partition F_Utilization_Summary-a6f820c2-b19f-4692-8575-a0fe5484e4e0 = calculated
		mode: import
		source = UNION(SUMMARIZECOLUMNS('Wanek'[WH],'Wanek'[CONTAINER#],'Wanek'[Cont_Categories],'Wanek'[WCHCONTAINERSIZE],'Wanek'[WCIDESTINATION],'Wanek'[H_CUBES],'Wanek'[CONTAINER#2],'Wanek'[CONTAINERTYPE],"Qty",sum('Wanek'[QTY]),"Total_Cartons",sum('Wanek'[CARTONS]),"Date",MAX('Wanek'[DATE])),SUMMARIZECOLUMNS('Millennium'[WH],'Millennium'[CONTAINER#],'Millennium'[Cont_Categories],'Millennium'[WCHCONTAINERSIZE],'Millennium'[WCIDESTINATION],'Millennium'[H_CUBES],Millennium[CONTAINER#2],'Millennium'[CONTAINERTYPE],"Qty",sum('Millennium'[QTY]),"Total_Cartons",sum('Millennium'[CARTONS]),"Date",MAX('Millennium'[DATE])),SUMMARIZECOLUMNS('Ashton'[WH],'Ashton'[CONTAINER#],'Ashton'[Cont_Categories],'Ashton'[Container_size_final],'Ashton'[Destination],'Ashton'[ConatinerTotalCubes],'Ashton'[CONTAINER#2],'Ashton'[ContainerType],"Qty",SUM('Ashton'[ITSHQT]),"Total_Cartons",SUM(Ashton[ITSHQT]),"Date",MAX('Ashton'[Date])))

	annotation PBI_Id = 2916c4b58fb246ef9a99e7c5bb0411ea

