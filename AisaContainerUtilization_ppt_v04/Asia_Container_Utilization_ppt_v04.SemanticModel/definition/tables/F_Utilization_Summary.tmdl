			MID('F_Utilization_Summary'[WCHCONTAINERSIZE],1,2) = "40", 'F_Utilization_Summary'[CUBES]/2383,
			MID('F_Utilization_Summary'[WCHCONTAINERSIZE],1,1) = "2", 'F_Utilization_Summary'[CUBES]/1191,
			'F_Utilization_Summary'[CUBES]/2650)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3292cfe0-f764-470d-903c-4157a31a5ed9
