	column Cont_Categories = IF('Millennium'[ContainerType]="Mixed","Mixed",if(and('Millennium'[Product]="UPH",SUMX(FILTER('Millennium','Millennium'[Container#]=EARLIER('Millennium'[Container#])),'Millennium'[Judge])=0),"Motion",if(and('Millennium'[Product]="UPH",SUMX(FILTER('Millennium','Millennium'[Container#]=EARLIER('Millennium'[Container#])),'Millennium'[Judge])=COUNTX(FILTER('Millennium','Millennium'[Container#]=EARLIER('Millennium'[Container#])),'Millennium'[Judge])),"Stationary",if(and('Millennium'[Product]="UPH",SUMX(FILTER('Millennium','Millennium'[Container#]=EARLIER('Millennium'[Container#])),'Millennium'[Judge])<COUNTX(FILTER('Millennium','Millennium'[Container#]=EARLIER('Millennium'[Container#])),'Millennium'[Judge])),"Mixed",'Millennium'[Product]))))
		lineageTag: c7942467-bd65-49fc-bf13-9f2385004ea4
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Judge = if(and('Millennium'[PRODUCT]="UPH",'Millennium'[MS]="Motion"),0,if(and('Millennium'[Product]="UPH",'Millennium'[MS]="Stationary"),1,9999))
