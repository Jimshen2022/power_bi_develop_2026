	column MS = IF(AND('Millennium'[PRODUCT]="UPH",LOOKUPVALUE('M&S'[Kind],'M&S'[Item],'Millennium'[ITEMNUMBER])="Motion"),"Motion", IF(AND('Millennium'[PRODUCT]="UPH",LOOKUPVALUE('M&S'[Kind],'M&S'[Item],'Millennium'[ITEMNUMBER])<>"Motion"),"Stationary",""))
		lineageTag: cff8d8ac-5c44-4f44-a45b-01992c42ea91
