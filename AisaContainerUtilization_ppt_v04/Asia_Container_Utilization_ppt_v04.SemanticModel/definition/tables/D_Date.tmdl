	partition D_Date-68248cba-ee61-4b35-b5c7-eb3f0c967f2f = calculated
		mode: import
		source =
				filter(ADDCOLUMNS(
				        CALENDAR(today()-65,DATE(2038, 12, 31)),
				         "Year",YEAR([Date]),
				         "Month",Month([Date]),
				         "Day", day([Date]),
				         "Weekday", WEEKDAY([Date],1),
				         "Week Number", WEEKNUM([Date],1),
				         "Quarter",YEAR([Date])&"Q"&QUARTER([Date]),
				         "YearMonth",year([Date])*100+MONTH([Date]),
				         "YearWeek", year([Date])*100+WEEKNUM([Date],1)),[Date]<=TODAY())

	annotation PBI_Id = a30d6d920da84893823c0f759b8171a4

