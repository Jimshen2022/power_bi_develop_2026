	partition ashton_sn_orphaned_notice = m
		mode: import
		source =
				let
				    Source = Sql.Database("AshtonWHJSQLprod", "AAD", [Query="DECLARE @N INT = 60;  -- 设定天数，1=今天，2=昨天+今天，7=最近7天#(lf)#(lf)With st as (#(lf)    select a.wh_id,#(lf)        a.serial_number, #(lf)        a.item_number, #(lf)        a.po_number, #(lf)        a.location_id, #(lf)        a.received_date,#(lf)          CASE#(lf)               WHEN a.item_number ='RP ORDER' and a.location_id = 'Shipped' then 'Shipped'#(lf)               WHEN a.serial_no_status = 'H' THEN 'Hold'#(lf)               WHEN ISNULL(a.serial_no_status, 'R') = 'R' THEN 'In Warehouse'#(lf)               WHEN a.serial_no_status = 'L' THEN 'Loaded'#(lf)               WHEN a.serial_no_status = 'S' THEN 'Shipped'#(lf)               WHEN a.serial_no_status = 'O' THEN 'Orphaned'#(lf)               ELSE 'Shipped'#(lf)             END AS serial_no_status#(lf)    from t_serial_active as a#(lf)    where a.wh_id = '335'#(lf)        #(lf))#(lf)SELECT #(lf)    t.wh_id,#(lf)    t.tran_type,#(lf)    t.description,#(lf)    t.exception_date,#(lf)    t.location_id as exception_loc,#(lf)    CAST(t.exception_date AS DATE) AS ExceptionDateOnly,  -- 新增：只保留日期部分#(lf)    t.item_number,#(lf)    t.class_id,#(lf)    t.lot_number,#(lf)    case #(lf)        when s.serial_no_status is null then 'Shipped'#(lf)        when s.location_id = 'NG001OP3' then 'Moved to NG001OP3'#(lf)        else s.serial_no_status end as current_sn_status,#(lf)    s.location_id as current_sn_loc,#(lf)    t.mo_number,#(lf)    t.employee_id,#(lf)    MAX(t.exception_date) OVER() AS LatestRecord           -- 新增列：最大时间（含时分秒）#(lf)FROM t_exception_tran_log AS t#(lf)left join st as s on s.serial_number = t.lot_number#(lf)WHERE t.exception_date >= DATEADD(DAY, -(@N - 1), CAST(GETDATE() AS DATE)) #(lf)  AND t.exception_date < DATEADD(DAY, 1, CAST(GETDATE() AS DATE)) #(lf)  AND t.tran_type = '99G'#(lf)  AND t.location_id NOT IN ('NG001OP3')#(lf)  --AND case #(lf)  --      when s.serial_no_status is null then 'Shipped'#(lf)  --      when s.location_id = 'NG001OP3' then 'Moved to NG001OP3'#(lf)  --      else s.serial_no_status end <> 'Moved to NG001OP3'#(lf)ORDER BY t.exception_date;#(lf)", CreateNavigationProperties=false, CommandTimeout=#duration(0, 8, 20, 0)]),
				  #"Filtered rows" = Table.SelectRows(Source, each ([description] = "SN are Orphaned") and ([wh_id] = "335"))
				in
				  #"Filtered rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

