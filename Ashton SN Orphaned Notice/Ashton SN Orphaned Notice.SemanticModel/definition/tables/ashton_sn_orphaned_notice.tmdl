table ashton_sn_orphaned_notice
	lineageTag: 06fd546b-1d19-4807-9e75-9d9bb9b01830

	measure Qty = count(ashton_sn_orphaned_notice[lot_number])
		formatString: #,0
		lineageTag: 70248291-b19c-4412-9308-3aa98965b68c

	measure Orphaned_BG_Color =
			
			IF(
			    SELECTEDVALUE('ashton_sn_orphaned_notice'[current_sn_status]) = "Orphaned",
			    "#FFFF00",   -- 黄色
			    BLANK()
			)
		lineageTag: 3c742711-a5d0-45a8-a3ff-cdedfbb5f9b3

	measure Show_VALUES =
			
			CONCATENATEX(
			    VALUES('ashton_sn_orphaned_notice'[current_sn_status]),
			    'ashton_sn_orphaned_notice'[current_sn_status],
			    ", "
			)
		lineageTag: 679686eb-5695-4af5-8782-3b3556df2607

	measure Show_HASONEVALUE =
			
			IF(
			    HASONEVALUE('ashton_sn_orphaned_notice'[current_sn_status]),
			    "TRUE (只有一个值)",
			    "FALSE (多个值)"
			)
		lineageTag: 36df7eaf-6a6f-4933-92b7-91ce19f70ca8

	measure Show_SELECTEDVALUE =
			
			SELECTEDVALUE(
			    'ashton_sn_orphaned_notice'[current_sn_status],
			    "多个值"
			)
		lineageTag: 6d02de62-e5b5-424f-a467-f5cf460656a4

	measure Status_BG_Color =
			
			SWITCH(
			    SELECTEDVALUE('ashton_sn_orphaned_notice'[current_sn_status]),
			    "Orphaned", "#FFFF00",   -- 黄
			    "Hold",     "#D3D3D3",   -- 灰
			    "Shipped",  "#90EE90",   -- 绿
			    BLANK()
			)
		lineageTag: f6153c2a-4fbc-4d69-8c85-36c6cb99dbe6

