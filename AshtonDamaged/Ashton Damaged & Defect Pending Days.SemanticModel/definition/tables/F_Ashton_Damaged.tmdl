		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition F_Ashton_Damaged = m
		mode: import
		source = ```
				// let
				//     Source = Sql.Database("ashley-edw.database.windows.net", "ASHLEY_EDW", [Query="-- Aug.16.2024 Updated Ashton damaged and defect products BI report by new process -- JimShen#(lf)-- To get serial number received into Ashton begin date from HJ transactions#(lf)WITH r1 AS (#(lf)    SELECT t1.wh_id#(lf)        , t1.item_number#(lf)        , CAST(t1.lot_number as VARCHAR(20)) AS SN#(lf)        , MIN(t1.start_tran_date) AS received_into_ashton_date#(lf)    FROM Distribution_Warehouse_Wholesale.TranLog AS t1#(lf)    WHERE t1.wh_id IN ('335') AND t1.start_tran_date > '2023-01-01' AND t1.lot_number is not null and len(t1.lot_number)>5#(lf)    GROUP BY t1.wh_id, t1.item_number, CAST(t1.lot_number as VARCHAR(20))#(lf)    ),#(lf)-- To get serial number received into location begin date from HJ transactions#(lf)    r2 AS (#(lf)    SELECT t1.wh_id#(lf)#(tab), t1.item_number#(lf)#(tab), CAST(t1.lot_number as VARCHAR(20)) AS SN#(lf)#(tab), t1.location_id_2#(lf)#(tab), MIN(t1.start_tran_date) AS received_into_loc_date#(lf)FROM Distribution_Warehouse_Wholesale.TranLog AS t1#(lf)WHERE t1.wh_id IN ('335') AND t1.start_tran_date > '2023-01-01' AND t1.lot_number is not null and len(t1.lot_number)>5#(lf)#(tab)AND t1.location_id_2 IN ('DM001AA1','NG001MT1','VD001AA1','EX001AA1','EX001AA2','SH001AA1','NG001CK3','NG001CG3','NG001UP3','NG001VD3','DR001AA1','DR001AB1') #(lf)GROUP BY t1.wh_id, t1.item_number, CAST(t1.lot_number as VARCHAR(20)), t1.location_id_2#(lf)    )#(lf)----------- Main ------------------------------------------------------------------#(lf)SELECT t1.wh_id#(lf)#(tab), t1.serial_number#(lf)#(tab), t1.item_number#(lf)#(tab), t1.po_number#(lf)#(tab), t1.location_id#(lf)#(tab), CASE#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'DM001AA1' THEN 'Damaged&Defect Main location'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001MT1' THEN 'Checking Mattresses(Over 150 days)'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'VD001AA1' THEN 'Inbound Vendor Damaged'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'EX001AA1' THEN 'Vendor Over Shipment'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'EX001AA2' THEN 'Extra Due to Operation Issue'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'SH001AA1' THEN 'Vendor Short Shipment'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001CK3' THEN 'Checking Pieces(Lack repair materials)'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001CG3' THEN 'Whse CaseGoods Damaged'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001UP3' THEN 'Whse UPH Damaged'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001VD3' THEN 'Send back to Vendor for fixing'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'DR001AA1' THEN 'Shipping Supervisor Unpick/Unload'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'DR001AB1' THEN 'Shipping Supervisor Unpick/Unload'#(lf)#(tab)#(tab)#(tab)ELSE 'Check' END AS Location_Meaning#(lf)    , CASE #(lf)            WHEN substring(t1.item_number,1,4) LIKE '100-' THEN 'CG' #(lf)            WHEN substring(t1.item_number,1,1) IN ('1','2','3','4','5','6','7','8','9','U') then 'UPH'#(lf)            WHEN substring(t1.item_number,1,1) IN ('A','B','D','E','G','H','L','M','P','R','T','W','Z') then 'CG'#(lf)            ELSE 'Check' END AS Item_Type #(lf)    , r1.received_into_ashton_date#(lf)    , r2.received_into_loc_date#(lf)FROM Distribution_Warehouse_Wholesale.t_serial_active  AS T1#(lf)    LEFT JOIN (SELECT * FROM r1) AS r1 ON t1.wh_id = r1.wh_id AND t1.item_number = r1.item_number AND t1.serial_number = r1.SN#(lf)    LEFT JOIN (SELECT * FROM r2) AS r2 ON t1.wh_id = r2.wh_id AND t1.item_number = r2.item_number AND t1.serial_number = r2.SN AND t1.location_id = r2.location_id_2#(lf)WHERE  t1.wh_id  IN ('335') #(lf)#(tab)AND T1.location_id IN ('DM001AA1','NG001MT1','VD001AA1','EX001AA1','EX001AA2','SH001AA1','NG001CK3','NG001CG3','NG001UP3','NG001VD3','DR001AA1','DR001AB1') #(lf)#(tab)AND t1.serial_no_status NOT IN ('O') and t1.master_status NOT IN ('S') ", CommandTimeout=#duration(0, 1, 0, 0)]),
				//     #"Changed Type" = Table.TransformColumnTypes(Source,{{"received_into_ashton_date", type date}, {"received_into_loc_date", type date}}),
				//     #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "PendingDays", 
				    
				//     each 
				//         if [received_into_loc_date] is null then Date.From(DateTime.LocalNow()) - [received_into_ashton_date]
				//         else if  [location_id] = "DM001AA1" then Date.From(DateTime.LocalNow()) - [received_into_loc_date]
				//         else if  [location_id] = "NG001MT1" then Date.From(DateTime.LocalNow()) - [received_into_ashton_date]
				//         else Date.From(DateTime.LocalNow()) - [received_into_loc_date] 
				//     ),
				//     #"Changed Type1" = Table.TransformColumnTypes(#"Added Conditional Column",{{"PendingDays", Int64.Type}}),
				//     #"Trimmed Text" = Table.TransformColumns(#"Changed Type1",{{"serial_number", Text.Trim, type text}}),
				//     #"Merged Queries" = Table.NestedJoin(#"Trimmed Text", {"serial_number"}, NGOC_CS, {"Serial Number"}, "NGOC_CS", JoinKind.LeftOuter),
				//     #"Expanded NGOC_CS" = Table.ExpandTableColumn(#"Merged Queries", "NGOC_CS", {"Vendor", "Issue from", "Damaged Description", "Reason", "Damaged by", "Whse deal with status", "CS replied", "CS Estimated Due Date"}, {"Vendor", "Issue from", "Damaged Description", "Reason", "Damaged by", "Whse deal with status", "CS replied", "CS Estimated Due Date"}),
				//     #"Merged Queries1" = Table.NestedJoin(#"Expanded NGOC_CS", {"serial_number"}, Vendor_Over_Short_Shipment, {"Serial Number"}, "Vendor_Over_Short_Shipment", JoinKind.LeftOuter),
				//     #"Expanded Vendor_Over_Short_Shipment" = Table.ExpandTableColumn(#"Merged Queries1", "Vendor_Over_Short_Shipment", {"CS replied", "CS Estimated Due Date"}, {"CS replied.1", "CS Estimated Due Date.1"})
				// in
				//     #"Expanded Vendor_Over_Short_Shipment"
				
				let
				    Source = Sql.Database("ashley-edw.database.windows.net", "ASHLEY_EDW", [Query="#(lf)-- Aug.16.2024 Updated Ashton damaged and defect products BI report by new process -- JimShen#(lf)-- To get serial number received into Ashton begin date from HJ transactions#(lf)WITH itm as (#(lf)    SELECT distinct b.ITNBR as item_number,b.PICKPUT as pick_put_id,#(lf)#(tab)case when b.PICKPUT = 'UPH' then 'UPH'#(lf)#(tab)else 'CG' end as product_category#(lf)#(tab)FROM MasterData_ItemMaster_AFI.ITBEXT b#(lf)    WHERE b.HOUSE IN ('335')#(lf)),#(lf)#(lf)r1 AS (#(lf)    SELECT t1.wh_id#(lf)        , t1.item_number#(lf)        , CAST(t1.lot_number as VARCHAR(20)) AS SN#(lf)        , MIN(t1.start_tran_date) AS received_into_ashton_date#(lf)    FROM Distribution_Warehouse_Wholesale.TranLog AS t1#(lf)    WHERE t1.wh_id IN ('335') AND t1.start_tran_date > '2023-01-01' AND t1.lot_number is not null and len(t1.lot_number)>5#(lf)    GROUP BY t1.wh_id, t1.item_number, CAST(t1.lot_number as VARCHAR(20))#(lf)    ),#(lf)-- To get serial number received into location begin date from HJ transactions#(lf)    r2 AS (#(lf)    SELECT t1.wh_id#(lf)#(tab), t1.item_number#(lf)#(tab), CAST(t1.lot_number as VARCHAR(20)) AS SN#(lf)#(tab), t1.location_id_2#(lf)#(tab), MIN(t1.start_tran_date) AS received_into_loc_date#(lf)FROM Distribution_Warehouse_Wholesale.TranLog AS t1#(lf)WHERE t1.wh_id IN ('335') AND t1.start_tran_date > '2023-01-01' AND t1.lot_number is not null and len(t1.lot_number)>5#(lf)#(tab)AND t1.location_id_2 IN ('DM001AA1','NG001CK3','NG001CG3','NG001UP3','NG001VD3') #(lf)GROUP BY t1.wh_id, t1.item_number, CAST(t1.lot_number as VARCHAR(20)), t1.location_id_2#(lf)    ),#(lf)#(lf)#(tab)-- To get serial number received into location begin date from HJ transactions#(lf)    r3 AS (#(lf)    SELECT t1.wh_id#(lf)#(tab), t1.item_number#(lf)#(tab), CAST(t1.lot_number as VARCHAR(20)) AS SN#(lf)#(tab), t1.location_id_2#(lf)#(tab), MIN(t1.start_tran_date) AS received_into_DM_date#(lf)FROM Distribution_Warehouse_Wholesale.TranLog AS t1#(lf)WHERE t1.wh_id IN ('335') AND t1.start_tran_date > '2023-01-01' AND t1.lot_number is not null and len(t1.lot_number)>5#(lf)#(tab)AND t1.location_id_2 IN ('DM001AA1') #(lf)GROUP BY t1.wh_id, t1.item_number, CAST(t1.lot_number as VARCHAR(20)), t1.location_id_2#(lf)    )#(lf)----------- Main ------------------------------------------------------------------#(lf)SELECT t1.wh_id#(lf)#(tab), t1.serial_number#(lf)#(tab), t1.item_number#(lf)#(tab), t1.po_number#(lf)#(tab), t1.location_id#(lf)#(tab), CASE#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'DM001AA1' THEN '(1) Damaged Item Entry Location - PendingInspection'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001CK3' THEN '(2) Repair Materials Required - CartonsDamaged'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001CG3' THEN '(3) Vendor Repair Required - ProductsDamaged'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001UP3' THEN '(3) Vendor Repair Required - ProductsDamaged'#(lf)#(tab)#(tab)#(tab)WHEN t1.location_id = 'NG001VD3' THEN '(4) Returned To Vendor For Repair'#(lf)#(tab)#(tab)#(tab)ELSE 'Check' END AS Location_Meaning#(lf)    , case when itm.product_category is null then #(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)case when left(t1.item_number,1) like '[U,1-9]%' THEN 'UPH' else 'CG' end#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)else itm.product_category end as Item_Type#(lf)    , r1.received_into_ashton_date#(lf)    , r2.received_into_loc_date#(lf)#(tab), CASE #(lf)#(tab)#(tab)#(tab)WHEN r3.received_into_DM_date IS NULL #(lf)#(tab)#(tab)#(tab)#(tab)THEN DATEADD(day, -1, r2.received_into_loc_date)#(lf)#(tab)#(tab)#(tab)WHEN r3.received_into_DM_date < r2.received_into_loc_date  #(lf)#(tab)#(tab)#(tab)#(tab)THEN DATEADD(day, -1, r2.received_into_loc_date)#(lf)#(tab)#(tab)#(tab)ELSE r3.received_into_DM_date #(lf)#(tab)#(tab)#(tab)END AS received_into_dm_date#(lf)#(lf)FROM Distribution_Warehouse_Wholesale.t_serial_active  AS T1#(lf)    LEFT JOIN (SELECT * FROM r1) AS r1 ON t1.wh_id = r1.wh_id AND t1.item_number = r1.item_number AND t1.serial_number = r1.SN#(lf)    LEFT JOIN (SELECT * FROM r2) AS r2 ON t1.wh_id = r2.wh_id AND t1.item_number = r2.item_number AND t1.serial_number = r2.SN AND t1.location_id = r2.location_id_2#(lf)    LEFT JOIN (SELECT * FROM r3) AS r3 ON t1.wh_id = r3.wh_id AND t1.item_number = r3.item_number AND t1.serial_number = r3.SN #(lf)#(tab)LEFT JOIN itm ON t1.item_number = itm.item_number#(lf)WHERE  t1.wh_id  IN ('335') #(lf)#(tab)AND T1.location_id IN ('DM001AA1','NG001CK3','NG001CG3','NG001UP3','NG001VD3') #(lf)#(tab)AND t1.serial_no_status NOT IN ('O') and t1.master_status NOT IN ('S') ", CommandTimeout=#duration(0, 10, 0, 0), CreateNavigationProperties=false]),
				
				    #"Changed Type" = Table.TransformColumnTypes(Source,
				        {
				            {"received_into_ashton_date", type date},
				            {"received_into_loc_date", type date},
				             {"received_into_dm_date", type date}
				        }
				    ),
				
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "PendingDays",
				        each
				            if [received_into_loc_date] is null then
				                Date.From(DateTime.LocalNow()) - [received_into_dm_date]
				
				            else if [location_id] = "DM001AA1" then
				                Date.From(DateTime.LocalNow()) - [received_into_dm_date]
				
				            else if [location_id] = "NG001MT1" then
				                Date.From(DateTime.LocalNow()) - [received_into_ashton_date]
				
				            else
				                Date.From(DateTime.LocalNow()) - [received_into_dm_date]
				    ),
				
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Conditional Column",
				        {
				            {"PendingDays", Int64.Type}
				        }
				    ),
				
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type1",
				        {
				            {"serial_number", Text.Trim, type text}
				        }
				    ),
				
				    #"Merged Queries" = Table.NestedJoin(
				        #"Trimmed Text",
				        {"serial_number"},
				        NGOC_CS,
				        {"Serial Number"},
				        "NGOC_CS",
