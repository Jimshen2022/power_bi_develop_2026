	column DateRange =
			SWITCH(TRUE(),
			'F_Ashton_Damaged'[PendingDays] < 3, "a.   0 ~ 3 days",
			'F_Ashton_Damaged'[PendingDays] < 7, "b.   3 ~ 7 days",
			'F_Ashton_Damaged'[PendingDays] < 14, "c.   7 ~ 14 days",
			'F_Ashton_Damaged'[PendingDays] < 21, "d.   14 ~ 21 days",
			'F_Ashton_Damaged'[PendingDays] < 30, "e.   21 ~ 30 days",
			'F_Ashton_Damaged'[PendingDays] < 60, "f.   30 ~ 60 days",
			'F_Ashton_Damaged'[PendingDays] < 90, "g.   60 ~ 90 days",
			'F_Ashton_Damaged'[PendingDays] < 180, "h.   3 ~ 6 Months",
			'F_Ashton_Damaged'[PendingDays] < 360, "i.   6 ~ 12 Months",
			'F_Ashton_Damaged'[PendingDays] < 540, "j.   1 ~ 1.5 Years",
			'F_Ashton_Damaged'[PendingDays] < 720, "k.   1.5 ~ 2 Years",
			'F_Ashton_Damaged'[PendingDays] < 900, "l.   2 ~ 2.5 Years",
			'F_Ashton_Damaged'[PendingDays] < 1080, "m.   2.5 ~ 3 Years",
			"n.   Over 3 Years")
