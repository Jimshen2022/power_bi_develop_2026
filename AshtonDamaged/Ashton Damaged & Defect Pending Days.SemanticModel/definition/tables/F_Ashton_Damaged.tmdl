	column Location_Goal =
			
			SWITCH(
			    TRUE(),
			    'F_Ashton_Damaged'[Location_Meaning] = "Operation Issue Extra Stock Area", "60 days",
			    'F_Ashton_Damaged'[Location_Meaning] = "Vendor Over Shipment Area", "30 days",
			    'F_Ashton_Damaged'[Location_Meaning] = "(1) Damaged Item Entry Location - PendingInspection", "7 days",
			    'F_Ashton_Damaged'[Location_Meaning] = "Vendor Short Shipment Area", "30 days",
			    'F_Ashton_Damaged'[Location_Meaning] = "(2) Repair Materials Required - CartonsDamaged", "21 days",
			    'F_Ashton_Damaged'[Location_Meaning] = "(3) Vendor Repair Required - ProductsDamaged", "14 days",
			    'F_Ashton_Damaged'[Location_Meaning] = "(4) Returned To Vendor For Repair", "30 days",
			    BLANK()
			)
		lineageTag: af0cf118-858c-4b53-a6e3-5819a47ddef8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Location_Status =
			
			IF(
			    'F_Ashton_Damaged'[PendingDays]
			        <= VALUE(MID('F_Ashton_Damaged'[Location_Goal],1,2)),
			    "Under Goal",
			    "Over Goal"
			)
		lineageTag: f63f62ef-2227-4dc8-8aa2-23568e13771d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column received_into_dm_date
		dataType: dateTime
