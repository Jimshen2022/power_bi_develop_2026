	column 'Container Size' =
			
			COALESCE(
			    LOOKUPVALUE(
			        'Fct_bo_bcs_infor'[BokContainerSize],
			        'Fct_bo_bcs_infor'[BokTripNumBer],
			        'Fct_ashton_bo_trips_planed_actual_qty_cubes'[trip_nbr]
			    ),
			    "40H"
			)
		lineageTag: a4131751-3ee8-4e63-a8d5-605fd34a8445
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Standard Cubes' = ```
			
			SWITCH(
			    TRUE(),
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "Mixed" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "40H", 2400,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "Mixed" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "40", 2150,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "Mixed" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "20", 1050,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "Mixed" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "45", 2400,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "Mixed" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "53", 2400,
			
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "UPH" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "40H", 2550,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "UPH" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "40", 2200,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "UPH" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "20", 1100,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "UPH" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "45", 2550,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "UPH" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "53", 2550,
			
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "CG" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "40H", 2350,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "CG" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "40", 2200,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "CG" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "20", 1000,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "CG" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "45", 2350,
			    'Fct_ashton_bo_trips_planed_actual_qty_cubes'[container_type] = "CG" && 'Fct_ashton_bo_trips_planed_actual_qty_cubes'[Container Size] = "53", 2350,
			    
			    2400
			)
			
			```
		formatString: #,0
