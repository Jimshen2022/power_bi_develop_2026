	column ShippedCubeColor_Measure = ```
			
			VAR ThisTrip = SELECTEDVALUE('Fct_ashton_bo_trips_planed_actual_qty_cubes'[trip_nbr])
			VAR TotalShipped = 
			    CALCULATE(
			        SUM('Fct_ashton_bo_trips_planed_actual_qty_cubes'[Shipped_Cube]),
			        ALLEXCEPT('Fct_ashton_bo_trips_planed_actual_qty_cubes','Fct_ashton_bo_trips_planed_actual_qty_cubes'[trip_nbr])
			    )
			VAR Standard = 
			    MAX('Fct_ashton_bo_trips_planed_actual_qty_cubes'[Standard Cubes])
			RETURN
			    SWITCH(
			        TRUE(),
			        TotalShipped >= Standard, "#A9D18E",         -- Green
			        TotalShipped < 0.95 * Standard, "#FFD966",   -- Yellow
			        "#F4B084"                                     -- Red
			    )
			// VAR ThisTrip = SELECTEDVALUE('Fct_ashton_bo_trips_planed_actual_qty_cubes'[trip_nbr])
